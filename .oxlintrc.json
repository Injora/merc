{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "oxc"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/components/cinematic/scene/**"
      ],
      "rules": {
        "react/immutability": "off"
      }
    }
  ],
  "ignorePatterns": [
    "public/draco/**",
    "public/basis/**",
    "dist/**",
    "scripts/fixtures/**"
  ]
}
